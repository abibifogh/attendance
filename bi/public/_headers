# Workers static assets read this file the way Pages does.
#
# The app is a handful of JavaScript modules loaded by a plain <script> tag,
# with no build step and no version in their names. Left to itself a browser
# keeps a module for a while after it has changed, so a deploy that adds a tab
# is a deploy some people do not see until they happen to reload hard — which
# is exactly what happened the day the Reports tab shipped. `no-cache` does
# not mean "do not cache": it means ask the server whether the copy is still
# good, and the ETag makes that answer a 304 with no body.
/js/*
  Cache-Control: no-cache
/styles.css
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
# The vendored libraries are fixed versions (see vendor/README.md). Upgrading
# one means a new file name, so a week's cache is safe.
/vendor/*
  Cache-Control: public, max-age=604800
/np.html
  Cache-Control: no-cache
/float.html
  Cache-Control: no-cache
# The service worker and the app icons: always the newest, so an update reaches every installed phone.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
# Once a phone has opened Insight securely, it never asks for it over plain http again.
/*
  Strict-Transport-Security: max-age=31536000
